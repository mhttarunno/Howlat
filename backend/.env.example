# Copy to .env and fill in. NEVER commit the real .env file.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the "Session pooler" or direct connection. SQLAlchemy driver prefix is added automatically.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Random secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=720

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Timezone used for "today", month buckets and overdue calculations
APP_TIMEZONE=Asia/Dhaka

# Set to false to close public registration after creating your account
ALLOW_REGISTRATION=true

# development | production
APP_ENV=development
