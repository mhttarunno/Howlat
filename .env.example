# Optional overrides for docker-compose.yml (copy to .env at repo root if needed)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=howlat

DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Generate a strong secret for non-local use:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=howlat-local-dev-secret-key-please-change-in-production-32chars
APP_ENV=development
APP_TIMEZONE=Asia/Dhaka
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost
ALLOW_REGISTRATION=true
ACCESS_TOKEN_MINUTES=720
